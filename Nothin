local function saveSettings()
if not writefile then return end
checkFolder()
local flat={}
for _,c in ipairs(siriusSettings) do
for _,s in ipairs(c.categorySettings) do
if s.current~=nil then flat[s.id]=s.current end
end
end
local es,e=pcall(httpService.JSONEncode,httpService,flat)
if not es then
warn("Sirius | Unable to encode settings: "..tostring(e))
return
end
pcall(writefile,settingsPath(),e)
end
local function assembleSettings()
if isfile and readfile and isfile(settingsPath()) then
local s,st=pcall(function() return httpService:JSONDecode(readfile(settingsPath())) end)
if s and type(st)=="table" then
for _,c in ipairs(siriusSettings) do
for _,setting in ipairs(c.categorySettings) do
local v=st[setting.id]
if v==nil and st[1] then
for _,sc in ipairs(st) do
if type(sc)=="table" and type(sc.categorySettings)=="table" then
for _,ss in ipairs(sc.categorySettings) do
if ss.id==setting.id then v=ss.current; break end
end
end
end
end
if v~=nil and (setting.current==nil or typeof(v)==typeof(setting.current)) then setting.current=v end
end
end
else
warn("Sirius | Settings file was unreadable and has been reset to defaults")
end
end
