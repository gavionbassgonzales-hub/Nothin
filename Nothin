local function loadWithTimeout(url,timeout)
assert(type(url)=="string","Expected string, got "..type(url))
timeout=timeout or 5
local done=false
local ok,res=false,nil
local t=task.spawn(function()
local s,r=pcall(game.HttpGet,game,url)
if not s or #r==0 then
if s and #r==0 then r="Empty response" end
ok,res=false,r
done=true
return
end
local s2,r2=pcall(function() return loadstring(r)() end)
ok,res=s2,r2
done=true
end)
local tt=task.delay(timeout,function()
if not done then
warn("Sirius | Request for "..url.." timed out after "..tostring(timeout).." seconds")
task.cancel(t)
res="Request timed out"
done=true
end
end)
while not done do task.wait() end
if coroutine.status(tt)~="dead" then task.cancel(tt) end
if not ok then
warn("Sirius | Failed to process "..tostring(url)..": "..tostring(res))
return nil
end
return res
end
