local function getAdaptiveHighPingThreshold()
local ab=siriusValues.pingProfile.adaptiveBaselinePings
if #ab==0 then return siriusValues.pingProfile.adaptiveHighPingThreshold end
table.sort(ab)
local med
if #ab%2==0 then med=(ab[#ab/2]+ab[#ab/2+1])/2 else med=ab[math.ceil(#ab/2)] end
return med*siriusValues.pingProfile.spikeThreshold
end
local function checkHighPing()
local rp=siriusValues.pingProfile.recentPings
local ab=siriusValues.pingProfile.adaptiveBaselinePings
local cp=getPing()
table.insert(rp,cp)
if #rp>siriusValues.pingProfile.maxSamples then table.remove(rp,1) end
if #ab<siriusValues.pingProfile.adaptiveBaselineSamples then
if cp>=350 then cp=300 end
table.insert(ab,cp)
return false
end
local ap=0
for _,p in ipairs(rp) do ap=ap+p end
ap=ap/#rp
if ap>getAdaptiveHighPingThreshold() then return true end
return false
end
