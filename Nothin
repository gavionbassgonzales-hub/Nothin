local function replacePlain(h,n,r)
if n=="" then return h end
local l=string.lower(h)
local o,c={},1
while true do
local s,e=string.find(l,n,c,true)
if not s then break end
table.insert(o,string.sub(h,c,s-1))
table.insert(o,r)
c=e+1
end
if c==1 then return h end
table.insert(o,string.sub(h,c))
return table.concat(o)
end
