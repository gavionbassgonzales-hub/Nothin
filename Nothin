local function updateSlider(data,setValue,forceValue)
if not data.object or not data.padding then return end
local ii
if setValue then
setValue=math.clamp(setValue,data.values[1],data.values[2])
ii=(setValue-data.values[1])/(data.values[2]-data.values[1])
else
local px=userInputService:GetMouseLocation().X
local posX=math.clamp(px,data.padding[1],data.padding[2])
local span=data.padding[2]-data.padding[1]
ii=span>0 and (posX-data.padding[1])/span or 0
end
tweenService:Create(data.object.Progress,TweenInfo.new(0.5,Enum.EasingStyle.Quint),{Size=UDim2.new(ii,0,1,0)}):Play()
local v=math.floor(data.values[1]+(data.values[2]-data.values[1])*ii+0.5)
data.object.Information.Text=v.." "..data.name
data.value=v
if data.callback and (not setValue or forceValue) then data.callback(v) end
end
